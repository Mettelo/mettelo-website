NEXT_PUBLIC_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
NEXT_PUBLIC_AUTH_CALLBACK_ORIGIN=http://127.0.0.1:3001
METTELO_MEMBER_ENVIRONMENT=staging
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Server-only opportunity runner (leave inactive until credentials are provisioned).
METTELO_PIPELINE_ENABLED=
METTELO_PIPELINE_SUPABASE_URL=https://jxijdjmjuzslmjxolhjl.supabase.co
METTELO_PIPELINE_SERVICE_ROLE_KEY=
# Optional aggregated UK/general discovery providers; never use NEXT_PUBLIC_ for these.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Meeting notices are opt-in and staging-only. Never put these in NEXT_PUBLIC_ variables.
METTELO_LAB_EMAIL_ENABLED=false
METTELO_LAB_SUPABASE_URL=https://jxijdjmjuzslmjxolhjl.supabase.co
METTELO_LAB_SERVICE_ROLE_KEY=
RESEND_API_KEY=
METTELO_LAB_EMAIL_FROM=
METTELO_LAB_EMAIL_ALLOWED_RECIPIENTS=

# Public SEO release gates. Leave disabled for local/staging. Private routes always stay noindex.
METTELO_PUBLIC_INDEXING_ENABLED=false
METTELO_PUBLIC_SITE_ORIGIN=
