{
  "name": "mettelo-member",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prebuild": "node ../../scripts/sync-design-tokens.mjs && node ../../scripts/build-job-taxonomy.mjs",
    "predev": "node ../../scripts/sync-design-tokens.mjs && node ../../scripts/build-job-taxonomy.mjs",
    "opportunities:dry-run": "node scripts/opportunity-discovery-dry-run.mjs",
    "opportunities:prepare": "node scripts/opportunity-pipeline.mjs prepare",
    "opportunities:run": "node scripts/opportunity-pipeline.mjs run",
    "opportunities:verify": "node scripts/opportunity-pipeline.mjs verify-sources",
    "opportunities:expire": "node scripts/opportunity-pipeline.mjs expiry",
    "opportunities:maintenance": "node scripts/opportunity-maintenance.mjs",
    "dev:preview": "node scripts/isolated-preview.mjs",
    "predev:preview": "node ../../scripts/sync-design-tokens.mjs && node ../../scripts/build-job-taxonomy.mjs",
    "lab:meeting-mail": "node scripts/lab-meeting-mail.mjs",
    "lab:weekly-pulse": "node scripts/lab-weekly-pulse.mjs",
    "lab:project-email-previews": "node scripts/project-email-previews.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.112.3",
    "fast-xml-parser": "5.11.2",
    "next": "15.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3"
  }
}
