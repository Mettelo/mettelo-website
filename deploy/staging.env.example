# Build-time public configuration: only the existing isolated test project.
METTELO_MEMBER_ENVIRONMENT=staging
NEXT_PUBLIC_SITE_ORIGIN=https://staging.mettelo.com
NEXT_PUBLIC_AUTH_CALLBACK_ORIGIN=https://staging.mettelo.com
NEXT_PUBLIC_SUPABASE_URL=https://jxijdjmjuzslmjxolhjl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-STAGING-PUBLISHABLE-KEY
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Runtime secrets: set these in the hosting control panel, never in an upload archive.
METTELO_STAGING_USERNAME=
METTELO_STAGING_PASSWORD_SHA256=
# Retain disabled sending and indexing. Auth verification/recovery is a separate service.
METTELO_PUBLIC_INDEXING_ENABLED=false
METTELO_PUBLIC_SITE_ORIGIN=
METTELO_LAB_EMAIL_ENABLED=false
METTELO_WEEKLY_PULSE_EMAIL_ENABLED=false
METTELO_PROJECT_EMAIL_ENABLED=false
METTELO_PIPELINE_ENABLED=
# Optional manual pipeline credentials must be server-only and staging-only.
METTELO_PIPELINE_SUPABASE_URL=https://jxijdjmjuzslmjxolhjl.supabase.co
METTELO_PIPELINE_SERVICE_ROLE_KEY=
